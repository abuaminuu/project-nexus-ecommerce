# contains secret keys for the project

# Django SECURITY WARNING: keep the secret key used in production secret!
DJANGO_SECRET_KEY=""
DEBUG=bool
ALLOWED_HOSTS=list

# CORS
CORS_ALLOWED_ORIGINS=bool
CORS_ALLOWED_ALL_ORIGINS=list

# Flutterwave Payment Gateway
FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_SECRET_HMAP=""

# ngrok
NGROK_TOKEN=""

# DATABASE (PostgreSQL)
# Alternative: Single connection string format used by django-environ / Heroku
# DATABASE_URL=postgres://postgres:postgres_password@localhost:5432/my_app_db

DB_ENGINE="django.db.backends.postgresql or its url"
DB_NAME="my_app_db"
DB_USER="postgres"
DB_PASSWORD="postgres_password"
DB_HOST="localhost"
DB_PORT="5432"


# REDIS & CELERY (Caching & Async Tasks)
REDIS_URL="redis://localhost:6379/1"
CELERY_BROKER_URL="redis://localhost:6379/0"

# react server url
REACT_SERVER_URL="127.0.0.1:3000"

# EMAIL / SMTP (Transactional Emails)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_HOST_USER="noreply@yourdomain.com"
EMAIL_HOST_PASSWORD="app-specific-password-here"
EMAIL_USE_TLS=bool


# CLOUD STORAGE (AWS S3 / Cloudinary)
AWS_ACCESS_KEY_ID="AKIAXXXXXXXXXXXXXXXX"
AWS_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
AWS_STORAGE_BUCKET_NAME="my-app-media-bucket"
AWS_S3_REGION_NAME="us-east-1"